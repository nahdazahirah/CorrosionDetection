@page "/"

<div class="home-page">

    <!-- HERO -->
    <section class="hero">
        <div class="hero-text">
            <span class="eyebrow">PT Pertamina Refinery Unit II — Kota Dumai</span>
            <h1>Deteksi Korosi Berbasis Computer Vision</h1>
            <p class="hero-desc">
                Sistem bantu inspeksi visual untuk mengidentifikasi dan mengukur luas area korosi
                pada peralatan industri secara cepat, konsisten, dan terdokumentasi.
            </p>

            <div class="hero-actions">
                <AuthorizeView>
                    <Authorized Context="homeCtx">
                        @if (homeCtx.User.IsInRole("Admin") || homeCtx.User.IsInRole("Operator"))
                        {
                            <a href="/corrosion" class="btn btn-primary">Mulai Deteksi</a>
                            <a href="/riwayat" class="btn btn-outline">Lihat Riwayat</a>
                        }
                        else
                        {
                            <a href="/riwayat" class="btn btn-primary">Lihat Riwayat</a>
                            <a href="/tentang" class="btn btn-outline">Tentang Sistem</a>
                        }
                    </Authorized>
                    <NotAuthorized>
                        <a href="/login" class="btn btn-primary">Masuk ke Sistem</a>
                        <a href="/tentang" class="btn btn-outline">Tentang Sistem</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>

        <div class="hero-art" aria-hidden="true">
            <svg viewBox="0 0 420 360" xmlns="http://www.w3.org/2000/svg">
                <rect x="0" y="0" width="420" height="360" rx="16" fill="#0C2A4E" />
                <g opacity="0.18" stroke="#FFFFFF" stroke-width="1">
                    <line x1="0" y1="60" x2="420" y2="60" />
                    <line x1="0" y1="120" x2="420" y2="120" />
                    <line x1="0" y1="180" x2="420" y2="180" />
                    <line x1="0" y1="240" x2="420" y2="240" />
                    <line x1="0" y1="300" x2="420" y2="300" />
                    <line x1="70" y1="0" x2="70" y2="360" />
                    <line x1="140" y1="0" x2="140" y2="360" />
                    <line x1="210" y1="0" x2="210" y2="360" />
                    <line x1="280" y1="0" x2="280" y2="360" />
                    <line x1="350" y1="0" x2="350" y2="360" />
                </g>
                <rect x="90" y="90" width="240" height="180" rx="10" fill="none" stroke="#5B3FA0" stroke-width="2.5" />
                <path d="M120 210 q20 -30 40 -10 q15 20 35 -5 q18 -22 38 4 q16 20 34 -8"
                      fill="none" stroke="#8FA6C9" stroke-width="2" />
                <circle cx="160" cy="150" r="16" fill="#C62828" opacity="0.85" />
                <circle cx="230" cy="190" r="10" fill="#C62828" opacity="0.65" />
                <circle cx="270" cy="140" r="7" fill="#C62828" opacity="0.5" />
                <rect x="150" y="138" width="20" height="24" rx="3" fill="none" stroke="#FFFFFF" stroke-width="1.5" opacity="0.8" />
                <line x1="90" y1="180" x2="60" y2="180" stroke="#5B3FA0" stroke-width="2" />
                <line x1="330" y1="180" x2="360" y2="180" stroke="#5B3FA0" stroke-width="2" />
            </svg>
        </div>
    </section>

    <!-- STATS -->
    <section class="stats">
        <div class="stat-card">
            <span class="stat-value">9.222+</span>
            <span class="stat-label">Gambar data latih</span>
        </div>
        <div class="stat-card">
            <span class="stat-value">77,3%</span>
            <span class="stat-label">mAP50 segmentasi</span>
        </div>
        <div class="stat-card">
            <span class="stat-value">Real-time</span>
            <span class="stat-label">Pemindaian webcam</span>
        </div>
        <div class="stat-card">
            <span class="stat-value">3 Peran</span>
            <span class="stat-label">Admin · Operator · Viewer</span>
        </div>
    </section>

    <!-- CARA KERJA -->
    <section class="how-it-works">
        <h2>Cara Kerja</h2>
        <div class="steps">
            <div class="step">
                <span class="step-num">01</span>
                <strong>Ambil Gambar</strong>
                <p>Unggah foto peralatan atau gunakan webcam untuk pemindaian langsung.</p>
            </div>
            <div class="step">
                <span class="step-num">02</span>
                <strong>Analisis Model</strong>
                <p>Model YOLOv8n-seg mendeteksi dan menandai area korosi beserta luas areanya.</p>
            </div>
            <div class="step">
                <span class="step-num">03</span>
                <strong>Tinjau &amp; Simpan</strong>
                <p>Hasil tersimpan otomatis di riwayat, siap ditinjau dan difilter kapan saja.</p>
            </div>
        </div>
    </section>
</div>
