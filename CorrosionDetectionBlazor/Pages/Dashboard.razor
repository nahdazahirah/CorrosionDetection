@page "/"
@using CorrosionDetection.Blazor.Models
@inject HttpClient Http
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Dashboard</PageTitle>

<div style="text-align:center; margin-top: 20px;">
    <h2>Dashboard Monitoring Korosi (Real-time Webcam)</h2>

    <div style="margin-bottom: 10px;">
        @if (!isCameraOn)
        {
            <button class="btn btn-primary" @onclick="StartCamera">Mulai Kamera</button>
        }
        else
        {
            <button class="btn btn-danger" @onclick="StopCamera">Hentikan Kamera</button>
        }
        <span style="margin-left: 15px;">
            Interval sampling:
            <select @bind="samplingIntervalSeconds" @bind:after="OnIntervalChanged">
                <option value="3">3 detik</option>
                <option value="5">5 detik</option>
                <option value="10">10 detik</option>
            </select>
        </span>
    </div>

    <div style="position: relative; display: inline-block; border: 3px solid #333; border-radius: 6px; padding: 4px;">
        <video id="webcamVideo" autoplay playsinline style="max-width: 640px; display:block;"></video>
        <canvas id="webcamCanvas" style="display:none;"></canvas>

        @if (latestDetections.Count > 0)
        {
            @foreach (var d in latestDetections)
            {
                <div style="position:absolute;
                    left:@(d.X / videoWidth * 100)%;
                    top:@(d.Y / videoHeight * 100)%;
                    width:@(d.Width / videoWidth * 100)%;
                    height:@(d.Height / videoHeight * 100)%;
                    border:2px solid red;
                    box-sizing:border-box;">

                    @if (!string.IsNullOrEmpty(d.MaskImageBase64))
                    {
                        <img src="data:image/png;base64,@d.MaskImageBase64"
                             style="width:100%; height:100%; position:absolute; top:0; left:0; pointer-events:none;" />
                    }

                    <span style="background:red; color:white; font-size:11px; padding:1px 3px; position:relative; z-index:1;">
                        @(d.AreaPercentage.ToString("0.0"))%
                    </span>
                </div>
            }
        }
    </div>

    @if (isProcessing)
    {
        <p><em>Memproses frame...</em></p>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <p style="color:red;">@errorMessage</p>
    }

    <hr />

    <h3>Histori Deteksi</h3>
    <table style="margin: 0 auto; border-collapse: collapse;" border="1" cellpadding="6">
        <thead>
            <tr>
                <th>Waktu</th>
                <th>Jumlah Deteksi</th>
                <th>Area Terbesar (%)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var log in history.OrderByDescending(h => h.Timestamp).Take(20))
            {
                <tr>
                    <td>@log.Timestamp.ToString("HH:mm:ss")</td>
                    <td>@log.DetectionCount</td>
                    <td>@log.MaxAreaPercentage.ToString("0.0")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private bool isCameraOn = false;
    private bool isProcessing = false;
    private string? errorMessage;
    private int samplingIntervalSeconds = 5;
    private float videoWidth = 640;
    private float videoHeight = 480;
    private List<DetectionResult> latestDetections = new();
    private List<HistoryEntry> history = new();
    private Timer? samplingTimer;
    private DotNetObjectReference<Dashboard>? dotNetRef;

    private record HistoryEntry(DateTime Timestamp, int DetectionCount, float MaxAreaPercentage);

    private async Task StartCamera()
    {
        errorMessage = null;
        try
        {
            dotNetRef = DotNetObjectReference.Create(this);
            // Fungsi JS ini perlu ditambahkan ke wwwroot/js/webcam.js (lihat catatan di bawah)
            var dims = await JS.InvokeAsync<int[]>("webcamInterop.start", "webcamVideo");
            videoWidth = dims[0];
            videoHeight = dims[1];
            isCameraOn = true;
            StartSamplingTimer();
        }
        catch (Exception ex)
        {
            errorMessage = "Gagal mengakses kamera: " + ex.Message;
        }
    }

    private async Task StopCamera()
    {
        samplingTimer?.Dispose();
        samplingTimer = null;
        isCameraOn = false;
        await JS.InvokeVoidAsync("webcamInterop.stop", "webcamVideo");
    }

    private void OnIntervalChanged()
    {
        if (isCameraOn) StartSamplingTimer();
    }

    private void StartSamplingTimer()
    {
        samplingTimer?.Dispose();
        samplingTimer = new Timer(async _ => await CaptureAndDetect(),
            null, TimeSpan.Zero, TimeSpan.FromSeconds(samplingIntervalSeconds));
    }

    private async Task CaptureAndDetect()
    {
        if (isProcessing) return; // skip kalau masih proses frame sebelumnya
        isProcessing = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            // Ambil snapshot dari video sebagai byte array PNG lewat JS interop
            var imageBytes = await JS.InvokeAsync<byte[]>(
                "webcamInterop.captureFrame", "webcamVideo", "webcamCanvas");

            using var content = new MultipartFormDataContent();
            using var fileContent = new ByteArrayContent(imageBytes);
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("image/png");
            content.Add(fileContent, "image", "frame.png");

            var response = await Http.PostAsync("api/corrosion/detect", content);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<DetectionResponse>();
                if (result != null)
                {
                    latestDetections = result.Detections;
                    videoWidth = result.ImageWidth;
                    videoHeight = result.ImageHeight;

                    var maxArea = latestDetections.Count > 0
                        ? latestDetections.Max(d => d.AreaPercentage)
                        : 0f;
                    history.Add(new HistoryEntry(DateTime.Now, latestDetections.Count, maxArea));
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Error saat capture/deteksi: " + ex.Message;
        }
        finally
        {
            isProcessing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync()
    {
        samplingTimer?.Dispose();
        if (isCameraOn)
        {
            try { await JS.InvokeVoidAsync("webcamInterop.stop", "webcamVideo"); } catch { }
        }
        dotNetRef?.Dispose();
    }
}
