@page "/corrosion"
@using CorrosionDetection.Blazor.Models
@inject HttpClient Http

<div style="text-align:center; margin-top: 20px;">
    <h2>Upload Foto untuk Deteksi Korosi</h2>

    <div>
        <InputFile OnChange="OnFileSelected" accept="image/*" />
    </div>

    @if (isLoading)
    {
        <p><em>Sedang memproses...</em></p>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div>
            <span class="alert alert-danger" role="alert" style="display:inline-block; margin-top:10px;">@errorMessage</span>
        </div>
    }

    @if (imageDataUrl != null)
    {
        <div style="position: relative; display: inline-block; margin-top: 20px; border: 3px solid #333; border-radius: 6px; padding: 4px;">
            <img src="@imageDataUrl" style="max-width: 600px; display: block;" @ref="imageElement" />

            @foreach (var d in detections)
            {
                <div style="position:absolute;
                    left:@(d.X / originalWidth * 100)%;
                    top:@(d.Y / originalHeight * 100)%;
                    width:@(d.Width / originalWidth * 100)%;
                    height:@(d.Height / originalHeight * 100)%;
                    border:2px solid red;
                    box-sizing:border-box;">

                    @if (!string.IsNullOrEmpty(d.MaskImageBase64))
                    {
                        <img src="data:image/png;base64,@d.MaskImageBase64"
                             style="width:100%; height:100%; position:absolute; top:0; left:0; pointer-events:none;" />
                    }

                    <span style="background:red; color:white; font-size:11px; padding:1px 3px; position:relative; z-index:1;">
                        corrosion @((d.Confidence * 100).ToString("0.0"))% — area: @(d.AreaPercentage.ToString("0.0"))%
                    </span>
                </div>
            }
        </div>
    }
</div>


@code {
    private ElementReference imageElement;
    private string? imageDataUrl;
    private List<DetectionResult> detections = new();
    private bool isLoading = false;
    private string? errorMessage;
    private float originalWidth = 1;
    private float originalHeight = 1;

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        isLoading = true;
        detections.Clear();
        errorMessage = null;

        var buffer = new byte[file.Size];
        await file.OpenReadStream(maxAllowedSize: 10_000_000).ReadAsync(buffer);
        imageDataUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(buffer)}";

        using var content = new MultipartFormDataContent();
        using var fileContent = new ByteArrayContent(buffer);
        fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
        content.Add(fileContent, "image", file.Name);

        try
        {
            var response = await Http.PostAsync("api/corrosion/detect", content);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<DetectionResponse>();
                if (result != null)
                {
                    detections = result.Detections;
                    originalWidth = result.ImageWidth;
                    originalHeight = result.ImageHeight;
                }
            }
            else
            {
                errorMessage = $"Server returned {(int)response.StatusCode} {response.ReasonPhrase}";
            }
        }
        catch (System.Net.Http.HttpRequestException hre)
        {
            errorMessage = "Unable to reach backend API: " + hre.Message;
        }
        catch (Exception ex)
        {
            errorMessage = "Error while sending image: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}