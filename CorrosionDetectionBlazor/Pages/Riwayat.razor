@page "/riwayat"
@attribute [Authorize]
@using System.Net.Http.Json

<div class="riwayat-page">
    @if (confirmationSessionId.HasValue)
    {
        <div class="confirmation-toast" role="alertdialog" aria-live="assertive">
            <div class="toast-icon">!</div>
            <div class="toast-content">
                <strong>@(confirmationSessionId == -1 ? $"Hapus {selectedIds.Count} riwayat?" : "Hapus riwayat?")</strong>
                <span>Data deteksi ini akan dihapus secara permanen.</span>
            </div>
            <div class="toast-actions">
                <button class="toast-cancel-btn" @onclick="CancelDelete" disabled="@isDeleting">Batal</button>
                <button class="toast-confirm-btn"
                        @onclick="@(confirmationSessionId == -1 ? ConfirmBulkDelete : ConfirmDelete)"
                        disabled="@isDeleting">
                    @(isDeleting ? "Menghapus..." : "Hapus")
                </button>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(notificationMessage))
    {
        <div class="notification-toast @(notificationIsError ? "error" : "success")" role="status">
            <span>@notificationMessage</span>
            <button class="notification-close" @onclick="ClearNotification" aria-label="Tutup">×</button>
        </div>
    }

    <h2>Riwayat Deteksi Korosi</h2>
    <p class="subtitle">Menampilkan data hari ini. Gunakan filter untuk melihat tanggal lain.</p>

    <div class="toolbar">
        <div class="field">
            <label>Dari tanggal</label>
            <input type="date" @bind="fromDate" />
        </div>
        <div class="field">
            <label>Sampai tanggal</label>
            <input type="date" @bind="toDate" />
        </div>
        <div class="field">
            <label>Sumber</label>
            <select @bind="sourceType">
                <option value="">Semua</option>
                <option value="upload">Upload</option>
                <option value="webcam">Webcam</option>
            </select>
        </div>
        <div class="field">
            <label>Urutkan</label>
            <select @bind="sortBy">
                <option value="date">Tanggal/Waktu</option>
                <option value="area">Luas Area Terbesar</option>
                <option value="count">Jumlah Deteksi</option>
            </select>
        </div>
        <button class="apply-btn" @onclick="LoadHistory">Terapkan</button>
        <button class="today-btn" @onclick="ResetToToday">Hari Ini</button>
    </div>

    @if (isLoading)
    {
        <p class="status-msg">Memuat riwayat...</p>
    }
    else if (sessions.Count == 0)
    {
        <p class="status-msg">Belum ada riwayat deteksi untuk rentang ini.</p>
    }
    else
    {
        
        @if (selectedIds.Count > 0)
        {
            <div class="bulk-toolbar">
                <span class="selected-count">@selectedIds.Count dipilih</span>
                <AuthorizeView Roles="Admin" Context="bulkCtx">
                    <Authorized>
                        <button class="bulk-delete-btn" @onclick="AskBulkDelete">Hapus Terpilih</button>
                    </Authorized>
                </AuthorizeView>
            </div>
        }
        
        <table class="history-table">
            <thead>
                <tr>
                    <th>
                        <label class="select-all-label">
                            <input type="checkbox" checked="@AllSelected" @onchange="ToggleSelectAll" />
                            Pilih Semua
                        </label>
                    </th>
                    <th>Tanggal</th>
                    <th>Waktu</th>
                    <th>Sumber</th>
                    <th>Jumlah Deteksi</th>
                    <th>Area Terbesar</th>
                    <th>Detail</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in sessions)
                {
                    <tr class="data-row">
                        <td>
                            <input type="checkbox"
                                   checked="@selectedIds.Contains(s.Id)"
                                   @onchange="e => ToggleSelectOne(s.Id, e)" />
                        </td>
                        
                        <td>@s.Timestamp.ToString("dd MMM yyyy", new System.Globalization.CultureInfo("id-ID"))</td>
                        <td>@s.Timestamp.ToString("HH:mm:ss")</td>
                        <td><span class="badge-source">@s.SourceType</span></td>
                        <td>@s.DetectionCount</td>
                        <td>
                            <span class="area-value @(s.MaxAreaPercentage > 20 ? "high" : "")">
                                @s.MaxAreaPercentage.ToString("0.0")%
                            </span>
                        </td>
                        <td class="action-cell">
                            <button class="detail-btn" @onclick="() => ToggleExpand(s.Id)">
                                @(expandedId == s.Id ? "Tutup" : "Lihat")
                            </button>
                            <AuthorizeView Roles="Admin" Context="authCtx">
                                <Authorized>
                                    <button class="delete-btn" @onclick="() => AskDelete(s.Id)">Hapus</button>
                                </Authorized>
                            </AuthorizeView>
                        </td>
                    </tr>
                    @if (expandedId == s.Id)
                    {
                        <tr>
                            <td colspan="7" style="padding:0;">
                                <div class="detail-panel">
                                    @if (!string.IsNullOrEmpty(s.OriginalImageBase64))
                                    {
                                        <div class="detail-image-wrap">
                                            <img src="data:image/png;base64,@s.OriginalImageBase64" />

                                            @foreach (var item in s.Items)
                                            {
                                                <div style="position:absolute;
                                                    left:@(item.X / s.ImageWidth * 100)%;
                                                    top:@(item.Y / s.ImageHeight * 100)%;
                                                    width:@(item.Width / s.ImageWidth * 100)%;
                                                    height:@(item.Height / s.ImageHeight * 100)%;
                                                    border:2px solid red;
                                                    box-sizing:border-box;">
                                                    <span style="background:red; color:white; font-size:9px; padding:1px 3px;">
                                                        @item.AreaPercentage.ToString("0.0")%
                                                    </span>
                                                </div>
                                            }
                                        </div>
                                        <p class="image-size-caption"><strong>Ukuran gambar:</strong> @s.ImageWidth × @s.ImageHeight px</p>
                                    }
                                    else
                                    {
                                        <p style="opacity:0.7; font-style:italic; text-align:center;">Gambar tidak tersedia untuk sesi ini.</p>
                                        <p class="image-size-caption"><strong>Ukuran gambar:</strong> @s.ImageWidth × @s.ImageHeight px</p>
                                    }

                                    <ul class="detail-list">
                                        @foreach (var item in s.Items)
                                        {
                                            <li>
                                                Posisi (@item.X.ToString("0"), @item.Y.ToString("0")) ·
                                                ukuran @item.Width.ToString("0")×@item.Height.ToString("0") px ·
                                                confidence @((item.Confidence * 100).ToString("0.0"))% ·
                                                area @item.AreaPercentage.ToString("0.0")%
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }
</div>

@code {
    [Inject] private HttpClient Http { get; set; } = default!;

    private List<SessionDto> sessions = new();
    private bool isLoading = false;
    private int? expandedId = null;
    private int? confirmationSessionId = null;
    private bool isDeleting = false;
    private string? notificationMessage;
    private bool notificationIsError;

    private DateTime? fromDate = DateTime.Today;
    private DateTime? toDate = DateTime.Today;
    private string sourceType = "";
    private string sortBy = "date";

    private HashSet<int> selectedIds = new();
    private bool isBulkDeleting = false;

    private bool AllSelected => sessions.Count > 0 && selectedIds.Count == sessions.Count;


    protected override async Task OnInitializedAsync() => await LoadHistory();

    private async Task ResetToToday()
    {
        fromDate = DateTime.Today;
        toDate = DateTime.Today;
        await LoadHistory();
    }

    private async Task LoadHistory()
    {
        isLoading = true;
        expandedId = null;
        selectedIds.Clear();

        var query = new List<string>();
        if (fromDate.HasValue) query.Add($"fromDate={fromDate:yyyy-MM-dd}");
        if (toDate.HasValue) query.Add($"toDate={toDate:yyyy-MM-dd}");
        if (!string.IsNullOrEmpty(sourceType)) query.Add($"sourceType={sourceType}");
        query.Add($"sortBy={sortBy}");
        query.Add("sortDesc=true");

        try
        {
            var result = await Http.GetFromJsonAsync<List<SessionDto>>(
                "api/corrosion/history?" + string.Join("&", query));
            sessions = result ?? new();
        }
        catch { sessions = new(); }
        finally { isLoading = false; }
    }

    private void AskDelete(int id)
    {
        confirmationSessionId = id;
        notificationMessage = null;
    }

    private void CancelDelete()
    {
        if (!isDeleting)
            confirmationSessionId = null;
    }

    private async Task ConfirmDelete()
    {
        if (!confirmationSessionId.HasValue)
            return;

        var id = confirmationSessionId.Value;
        isDeleting = true;

        try
        {
            var response = await Http.DeleteAsync($"api/corrosion/history/{id}");
            if (response.IsSuccessStatusCode)
            {
                sessions.RemoveAll(s => s.Id == id);
                if (expandedId == id)
                    expandedId = null;

                notificationMessage = "Riwayat berhasil dihapus.";
                notificationIsError = false;
                confirmationSessionId = null;
            }
            else
            {
                notificationMessage = "Riwayat gagal dihapus. Silakan coba lagi.";
                notificationIsError = true;
            }
        }
        catch
        {
            notificationMessage = "Tidak dapat terhubung ke server.";
            notificationIsError = true;
        }
        finally
        {
            isDeleting = false;
        }
    }

    private void ClearNotification() => notificationMessage = null;

    private void ToggleExpand(int id) => expandedId = expandedId == id ? null : id;

    private class SessionDto
    {
        public int Id { get; set; }
        public DateTime Timestamp { get; set; }
        public string SourceType { get; set; } = "";
        public int ImageWidth { get; set; }
        public int ImageHeight { get; set; }
        public int DetectionCount { get; set; }
        public float MaxAreaPercentage { get; set; }
        public string? OriginalImageBase64 { get; set; }
        public List<ItemDto> Items { get; set; } = new();
    }

    private class ItemDto
    {
        public float X { get; set; }
        public float Y { get; set; }
        public float Width { get; set; }
        public float Height { get; set; }
        public float Confidence { get; set; }
        public float AreaPercentage { get; set; }
        public string? MaskImageBase64 { get; set; }
    }

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        var isChecked = (bool)(e.Value ?? false);
        selectedIds = isChecked
            ? sessions.Select(s => s.Id).ToHashSet()
            : new HashSet<int>();
    }

    private void ToggleSelectOne(int id, ChangeEventArgs e)
    {
        var isChecked = (bool)(e.Value ?? false);
        if (isChecked) selectedIds.Add(id);
        else selectedIds.Remove(id);
    }

    private void AskBulkDelete()
    {
        if (selectedIds.Count == 0) return;
        confirmationSessionId = -1; // penanda khusus: -1 berarti mode bulk delete
        notificationMessage = null;
    }

    private async Task ConfirmBulkDelete()
    {
        isDeleting = true;
        var idsToDelete = selectedIds.ToList();
        int successCount = 0;

        foreach (var id in idsToDelete)
        {
            try
            {
                var response = await Http.DeleteAsync($"api/corrosion/history/{id}");
                if (response.IsSuccessStatusCode)
                {
                    sessions.RemoveAll(s => s.Id == id);
                    successCount++;
                }
            }
            catch { /* lanjut ke id berikutnya walau satu gagal */ }
        }

        selectedIds.Clear();
        confirmationSessionId = null;
        isDeleting = false;

        notificationMessage = successCount == idsToDelete.Count
            ? $"{successCount} riwayat berhasil dihapus."
            : $"{successCount} dari {idsToDelete.Count} riwayat berhasil dihapus.";
        notificationIsError = successCount < idsToDelete.Count;
    }
}