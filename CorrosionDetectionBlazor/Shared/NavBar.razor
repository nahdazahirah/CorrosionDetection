<nav class="navbar">

    <div class="navbar-brand">
        <span class="logo">CorrosionDetect</span>
    </div>


    <div class="navbar-links">
        <NavLink href="/" Match="NavLinkMatch.All">Home</NavLink>

        <AuthorizeView Roles="Admin,Operator">
            <NavLink href="/corrosion">Deteksi Korosi</NavLink>
        </AuthorizeView>

        <NavLink href="/riwayat">Riwayat</NavLink>

        <NavLink href="/tentang">Tentang</NavLink>

        <AuthorizeView Context="authCtx">
            <Authorized>
                <NavLink href="/profile" class="profile-link">
                    @(authCtx.User.Identity?.Name ?? "Profil")
                </NavLink>
            </Authorized>
            <NotAuthorized>
                <NavLink href="/login">Masuk</NavLink>
            </NotAuthorized>
        </AuthorizeView>

    </div>
</nav>

@code {
    [Inject] private CorrosionDetectionBlazor.Auth.CustomAuthStateProvider AuthStateProvider { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;

    private async Task Logout()
    {
        await AuthStateProvider.MarkUserAsLoggedOut();
        Nav.NavigateTo("/login", forceLoad: true);
    }
}